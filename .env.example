# OpenAI-compatible API credentials (not required when running with --dry-run)
OPENAI_API_KEY=sk-your-api-key-here

# Optional custom OpenAI-compatible gateway (e.g. OpenRouter, DeepSeek, vLLM, OneAPI)
OPENAI_BASE_URL=https://api.openai.com/v1

# Primary LLM model identifier used by PM / DEV / QA / Arbiter / Judge agents
META_DEV_MODEL=gpt-4o
